NODE_ENV=development
PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://settlecraft@localhost:55432/settlecraft?host=/tmp/settlecraft-pg
TEST_DATABASE_URL=postgresql://settlecraft@localhost:55432/settlecraft_test?host=/tmp/settlecraft-pg
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_PASSWORD=SettleCraft-demo-2026!

# Optional real email OTP delivery (Brevo transactional API, not an SMTP key).
# Configure locally; never commit credentials. Missing settings block verification safely.
# BREVO_API_KEY=your-brevo-api-key
# MAIL_FROM=your-verified-sender@example.com

# Foreground inactivity limit; polling does not renew sessions.
SESSION_IDLE_MINUTES=15
